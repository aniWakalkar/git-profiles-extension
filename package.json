{
  "name": "git-pros-profiles",
  "displayName": "Custom Git Profiles",
  "description": "Run custom Git command profiles (Normal, Migration, Frontend, etc.) from a sidebar with checkboxes. Create, edit and delete profiles from VS Code settings or the UI.",
  "version": "0.1.0",
  "publisher": "aniketwakalkar",
  "icon": "media/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "pros",
    "profiles",
    "commit",
    "push",
    "automation"
  ],
  "activationEvents": [
    "onView:gitProfilesView",
    "onView:gitChangesView"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitProfilesContainer",
          "title": "Custom Git Profiles",
          "icon": "media/git-profiles.svg"
        }
      ]
    },
    "views": {
      "gitProfilesContainer": [
        {
          "id": "gitProfilesView",
          "name": "Custom Git Profiles"
        },
        {
          "id": "gitChangesView",
          "name": "Changes"
        },
        {
          "id": "gitActionsView",
          "name": "Git Actions"
        }
      ]
    },
    "commands": [
      { "command": "gitProfiles.run", "title": "Custom Git Profiles: Run Profile" },
      { "command": "gitProfiles.createProfile", "title": "Custom Git Profiles: Create New Profile", "icon": "$(add)" },
      { "command": "gitProfiles.editProfile", "title": "Custom Git Profiles: Edit Profile" },
      { "command": "gitProfiles.deleteProfile", "title": "Custom Git Profiles: Delete Profile" },
      { "command": "gitProfiles.openSettings", "title": "Custom Git Profiles: Open Profiles in settings.json" },
      { "command": "gitProfiles.refreshView", "title": "Custom Git Profiles: Refresh", "icon": "$(refresh)" },
      { "command": "gitProfiles.runChecked", "title": "Run Checked Commands", "icon": "$(play)" },
      { "command": "gitProfiles.deleteProfileTree", "title": "Delete Profile", "icon": "$(trash)" },
      { "command": "gitProfiles.renameProfile", "title": "Rename Profile", "icon": "$(edit)" },
      { "command": "gitProfiles.addCommandToProfile", "title": "Add Command", "icon": "$(add)" },
      { "command": "gitProfiles.editCommand", "title": "Edit Command", "icon": "$(edit)" },
      { "command": "gitProfiles.deleteCommand", "title": "Delete Command", "icon": "$(trash)" },
      { "command": "gitProfiles.checkAllCommands", "title": "Select All Commands", "icon": "$(check-all)" },
      { "command": "gitProfiles.uncheckAllCommands", "title": "Deselect All Commands", "icon": "$(close-all)" },
      { "command": "gitProfiles.refreshChanges", "title": "Custom Git Profiles: Refresh Changes", "icon": "$(refresh)" },
      { "command": "gitProfiles.commitChanges", "title": "Commit Staged Changes", "icon": "$(save)" },
      { "command": "gitProfiles.stageAllChanges", "title": "Stage All Changes", "icon": "$(check-all)" },
      { "command": "gitProfiles.unstageAllChanges", "title": "Unstage All Changes", "icon": "$(close-all)" },
      { "command": "gitProfiles.openChangeDiff", "title": "Custom Git Profiles: Open Changes (Diff)" },
      { "command": "gitProfiles.discardChange", "title": "Discard Changes", "icon": "$(discard)" },
      { "command": "gitProfiles.revertFileToCommit", "title": "Revert to Specific Commit...", "icon": "$(history)" },
      { "command": "gitProfiles.revertCheckedFiles", "title": "Revert Checked Files", "icon": "$(discard)" },
      { "command": "gitProfiles.setAuthentication", "title": "Custom Git Profiles: Set Authentication", "icon": "$(key)" },
      { "command": "gitProfiles.clearAuthentication", "title": "Custom Git Profiles: Clear Authentication" },
      { "command": "gitProfiles.switchBranch", "title": "Custom Git Profiles: Switch Branch", "icon": "$(arrow-swap)" },
      { "command": "gitProfiles.pullChanges", "title": "Custom Git Profiles: Pull", "icon": "$(arrow-down)" },
      { "command": "gitProfiles.showCommitHistory", "title": "Custom Git Profiles: Show Commit History", "icon": "$(git-commit)" },
      { "command": "gitProfiles.setLogLocation", "title": "Custom Git Profiles: Set Command Log Location" },
      { "command": "gitProfiles.openCommandLog", "title": "Custom Git Profiles: Open Command Log File", "icon": "$(output)" },
      { "command": "gitProfiles.showCommandLogTerminal", "title": "Custom Git Profiles: Show Command Log Terminal" },
      { "command": "gitProfiles.toggleCommandLog", "title": "Custom Git Profiles: Toggle Command Log", "icon": "$(checklist)" },
      { "command": "gitProfiles.toggleTrainingWheels", "title": "Custom Git Profiles: Toggle Training Wheels", "icon": "$(mortar-board)" }
    ],
    "menus": {
      "view/title": [
        { "command": "gitProfiles.createProfile", "when": "view == gitProfilesView", "group": "navigation@1" },
        { "command": "gitProfiles.setAuthentication", "when": "view == gitProfilesView", "group": "navigation@2" },
        { "command": "gitProfiles.toggleTrainingWheels", "when": "view == gitProfilesView", "group": "navigation@3" },
        { "command": "gitProfiles.refreshView", "when": "view == gitProfilesView", "group": "navigation@4" },
        { "command": "gitProfiles.commitChanges", "when": "view == gitChangesView", "group": "navigation@1" },
        { "command": "gitProfiles.revertCheckedFiles", "when": "view == gitChangesView", "group": "navigation@2" },
        { "command": "gitProfiles.stageAllChanges", "when": "view == gitChangesView", "group": "navigation@3" },
        { "command": "gitProfiles.unstageAllChanges", "when": "view == gitChangesView", "group": "navigation@4" },
        { "command": "gitProfiles.refreshChanges", "when": "view == gitChangesView", "group": "navigation@5" },
        { "command": "gitProfiles.switchBranch", "when": "view == gitActionsView", "group": "navigation@1" },
        { "command": "gitProfiles.pullChanges", "when": "view == gitActionsView", "group": "navigation@2" },
        { "command": "gitProfiles.showCommitHistory", "when": "view == gitActionsView", "group": "navigation@3" },
        { "command": "gitProfiles.toggleCommandLog", "when": "view == gitActionsView", "group": "navigation@4" },
        { "command": "gitProfiles.openCommandLog", "when": "view == gitActionsView", "group": "navigation@5" }
      ],
      "view/item/context": [
        { "command": "gitProfiles.runChecked", "when": "view == gitProfilesView && viewItem == profile", "group": "inline@1" },
        { "command": "gitProfiles.addCommandToProfile", "when": "view == gitProfilesView && viewItem == profile", "group": "inline@2" },
        { "command": "gitProfiles.renameProfile", "when": "view == gitProfilesView && viewItem == profile", "group": "inline@3" },
        { "command": "gitProfiles.deleteProfileTree", "when": "view == gitProfilesView && viewItem == profile", "group": "inline@4" },
        { "command": "gitProfiles.checkAllCommands", "when": "view == gitProfilesView && viewItem == profile", "group": "1_selection" },
        { "command": "gitProfiles.uncheckAllCommands", "when": "view == gitProfilesView && viewItem == profile", "group": "1_selection" },
        { "command": "gitProfiles.editCommand", "when": "view == gitProfilesView && viewItem == command", "group": "inline@1" },
        { "command": "gitProfiles.deleteCommand", "when": "view == gitProfilesView && viewItem == command", "group": "inline@2" },
        { "command": "gitProfiles.discardChange", "when": "view == gitChangesView && viewItem == change", "group": "inline@1" },
        { "command": "gitProfiles.revertFileToCommit", "when": "view == gitChangesView && viewItem == change", "group": "1_modification" }
      ]
    },
    "configuration": {
      "title": "Custom Git Profiles",
      "properties": {
        "gitProfiles.profiles": {
          "type": "object",
          "description": "Named Git command profiles. Each key is a profile name, each value is an ordered list of shell commands to run. Starter profiles (Normal, Migration) are copied here on first use and can be deleted.",
          "default": {}
        },
        "gitProfiles.runInSameTerminal": {
          "type": "boolean",
          "default": true,
          "description": "If true, reuse a single 'Custom Git Profiles' terminal for every run. If false, a new terminal is created each time."
        },
        "gitProfiles.enableCommandLog": {
          "type": "boolean",
          "default": false,
          "description": "Off by default so no log file is created unless you opt in. When on, Custom Git Profiles logs every command it runs (profile commands and UI-triggered git commands alike) to a file and echoes them into a dedicated terminal. Toggle from 'Custom Git Profiles: Toggle Command Log' -- turning it on asks for confirmation first."
        },
        "gitProfiles.logFilePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the file where Custom Git Profiles logs every command it runs (profile commands and UI-triggered git commands alike), each with a short explanation. Leave empty to use the default location inside the extension's global storage. Use 'Custom Git Profiles: Set Command Log Location' to change this from a file picker instead of typing a path. Has no effect unless gitProfiles.enableCommandLog is on."
        },
        "gitProfiles.protectedBranches": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Branch names (e.g. \"main\", \"production\") that Custom Git Profiles will never merge into directly (e.g. via the commit panel's \"Also merge into other branches after pushing\" option). A trailing \"*\" matches as a prefix, e.g. \"release/*\". Merging into one of these pushes the source branch and opens a pull/merge request page instead, so a human has to review and approve it on the actual hosting platform -- git itself has no concept of approval, so this can't be enforced without going through that platform."
        },
        "gitProfiles.trainingWheels": {
          "type": "boolean",
          "default": false,
          "description": "When on, every meaningful Git command triggered from the UI (staging, committing, switching branches, merging, reverting, etc.) shows exactly what it's about to run and asks Yes/No before it runs. Off by default. Toggle from 'Custom Git Profiles: Toggle Training Wheels'."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aniketwakalkar/git-profiles-extension"
  },
  "scripts": {
    "vscode:prepublish": "echo no-build-step-needed"
  }
}
